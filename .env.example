# Copy this file to .env before starting the stack.
# Generate every secret independently; never reuse values or commit .env:
#   openssl rand -hex 32

CI_ENVIRONMENT=development
SHOP_ALLOW_ANONYMOUS_SHOP_ACCESS=false

# Required: at least 32 random bytes. Supported TTL range: 60-86400 seconds.
JWT_SECRET=
JWT_TIME_TO_LIVE=3600

# Password reset links use Vue hash routing. Configure SMTP in deployed environments.
PASSWORD_RESET_URL=https://localhost:8443/#/password-reset/confirm
PASSWORD_RESET_TIME_TO_LIVE=1800
MAIL_FROM_ADDRESS=no-reply@blatyrpg.local
MAIL_FROM_NAME=Blaty RPG
MAIL_PROTOCOL=smtp
MAIL_SMTP_HOST=
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_PORT=587
MAIL_SMTP_CRYPTO=tls

# Required: a different value of at least 32 random bytes.
REALTIME_TICKET_SECRET=
# Comma-separated exact browser origins; wildcards and URL paths are rejected.
REALTIME_ALLOWED_ORIGINS=https://localhost:8443
REALTIME_TICKET_ISSUER=BlatyRPG
REALTIME_TICKET_AUDIENCE=blatyrpg-realtime

MYSQL_DATABASE=blatyrpg
# Required: generate separate application and root database passwords.
MYSQL_APP_USER=blatyrpg_app
MYSQL_APP_PASSWORD=
MYSQL_ROOT_PASSWORD=
